# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=user_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/user_management

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
ENVIRONMENT=development
DEBUG=True

# External APIs
OPENAI_API_KEY=your-openai-api-key
UNSTRUCTURED_API_KEY=your-unstructured-api-key
UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general

# RAG Evaluation (DeepEval)
# Judge model for RAG metric scoring. Defaults to LLM_MODEL if unset.
# Recommended: a stronger non-free OpenRouter model, e.g. "openai/gpt-4o-mini".
EVAL_LLM_MODEL=
# Generate -> judge -> retry loop. Judge runs only if the structural gate passes.
EVAL_RETRY_ENABLED=1
# Max additional generations after the first (best-so-far returned if never passing).
EVAL_RETRY_MAX=3
# Minimum judge score (0-10) to accept a generation.
EVAL_RETRY_THRESHOLD=8
# Optional: push eval results to Confident AI dashboard.
# CONFIDENT_API_KEY=confident_us_...

# ---- MLflow GenAI Tracking ----
# Set to 1 to track every AI screening in MLflow (dev/staging).
MLFLOW_TRACKING_ENABLED=0
# Uri of the MLflow Tracking Server (Docker service name).
MLFLOW_TRACKING_URI=http://localhost:5000
# Override artifact path if needed (default: /tmp/mlflow/artifacts)
# MLFLOW_ARTIFACT_URI=/tmp/mlflow/artifacts
MLFLOW_EXPERIMENT_NAME=ai-screening
